# Raft self-hosting example — copy to .env and edit.
# Everything below is optional except JWT_SECRET and POSTGRES_PASSWORD.

# ── Required ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=

# ── Postgres ────────────────────────────────────────────────
# If the password contains URL-special characters, percent-encode it (the
# server receives it inside DATABASE_URL).
# POSTGRES_DB=raft
# POSTGRES_USER=raft

# ── Public URLs ─────────────────────────────────────────────
# URL that daemons/computers use to connect back to this server. Must be
# reachable from the machines running them; change before exposing remotely.
# SERVER_URL=http://localhost:3001

# Browser-facing origin (the caddy entrypoint).
# APP_URL=http://localhost:8080
# CORS_ORIGIN=http://localhost:8080

# ── Host ports ──────────────────────────────────────────────
# SERVER_PORT=3001
# HTTP_PORT=8080

# ── Object storage ──────────────────────────────────────────
# Defaults match the bundled rustfs service. Point these at MinIO / R2 /
# AWS S3 instead if you swap the storage backend (buckets must exist).
# S3_ACCESS_KEY_ID=raftminio
# S3_SECRET_ACCESS_KEY=raftminio-change-me
# S3_ATTACHMENTS_BUCKET=raft-attachments
# S3_CDN_BUCKET=raft-attachments

# ── Images ──────────────────────────────────────────────────
# Pin a date tag (YYYYMMDD) or sha tag in production instead of :latest.
# RAFT_SERVER_IMAGE=czyt/raft-server:latest
# RAFT_WEB_IMAGE=czyt/raft-web:latest
